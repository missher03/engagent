# Copy thành .env rồi điền key. Thiếu key nào thì module đó chạy ở chế độ MOCK (dữ liệu giả) để app vẫn dùng được.

# Chọn nhà cung cấp LLM: anthropic (Claude) hoặc minimax
LLM_PROVIDER=anthropic

# MiniMax (dùng khi LLM_PROVIDER=minimax). Key lấy trong console MiniMax (gói Token Plan).
# China: https://api.minimax.cn/anthropic   Global: https://api.minimax.io/anthropic
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/anthropic
MINIMAX_MODEL_FAST=MiniMax-M3.1-Flash
MINIMAX_MODEL_SMART=MiniMax-M3.1-Flash

# Claude (LLM): https://console.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-5-5      # sinh bài, giải nghĩa, câu hỏi
LLM_MODEL_SMART=claude-sonnet-5-5    # chấm viết, chấm nói, giám khảo

# Azure Speech (chấm phát âm): tạo resource "Speech" trên Azure portal
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Google Cloud Text-to-Speech: API key có bật Text-to-Speech API
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE_A=en-US-Neural2-D
GOOGLE_TTS_VOICE_B=en-US-Neural2-F

# Datamuse bắt buộc key từ 01/02/2027 (để trống nếu chưa có)
DATAMUSE_API_KEY=

# DB: mặc định SQLite. Đổi sang Postgres/Supabase: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./engagent.db
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:3000
